# Copy to .env and fill in. Never commit .env — anything committed to this
# repo is served publicly from synergysalon.com.

# Supabase, TRANSACTION POOLER (port 6543), not the direct connection:
# the direct one is IPv6 only and Vercel cannot reach it, so it works from a
# laptop and fails in production.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# CENTRO / GoHighLevel — the Synergy sub-account, not the agency one.
# Settings -> Private Integrations. Needs contacts and calendars.
GHL_LOCATION_ID=
GHL_TOKEN=
GHL_CALENDAR_ID=

# Guest email. Without it bookings still work and confirmations are skipped
# with a warning in the logs.
RESEND_API_KEY=

# Optional. Protects the cron endpoints; Vercel sends it automatically.
CRON_SECRET=

# Optional. Which salon to assume when the hostname matches nothing —
# for local work and preview deploys.
DEFAULT_TENANT=synergy

# Google Calendar (per staff member). Create these in Google Cloud Console:
# enable the Calendar API, add an OAuth client, and set the redirect URI to
# https://<your app host>/api/oauth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts Google refresh tokens at rest. Any long random string; changing it
# invalidates every existing connection, which people then re-authorise.
TOKEN_KEY=
