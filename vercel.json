{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.synergysalon.com"
        }
      ],
      "destination": "/staff",
      "permanent": false
    },
    {
      "source": "/book",
      "destination": "/?book=1",
      "permanent": false
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.synergysalon.com"
        }
      ],
      "destination": "https://synergysalon.com/:path",
      "permanent": true
    },
    {
      "source": "/staff",
      "has": [
        {
          "type": "host",
          "value": "synergysalon.com"
        }
      ],
      "destination": "https://app.synergysalon.com/",
      "permanent": false
    },
    {
      "source": "/staff/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "synergysalon.com"
        }
      ],
      "destination": "https://app.synergysalon.com/staff/:path",
      "permanent": false
    },
    {
      "source": "/join",
      "destination": "https://join.synergysalon.com/",
      "permanent": false
    },
    {
      "source": "/join/:path(.*)",
      "destination": "https://join.synergysalon.com/:path",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.synergysalon.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/sync",
      "schedule": "30 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/calendar/:token.ics",
      "destination": "/api/calendar?k=:token"
    },
    {
      "source": "/staff/:page(dashboard|appointments|contacts|settings)",
      "destination": "/staff"
    }
  ]
}
