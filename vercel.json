{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.synergysalon.com"
        }
      ],
      "destination": "https://synergysalon.com/:path",
      "permanent": true
    },
    {
      "source": "/join",
      "destination": "https://join.synergysalon.com/",
      "permanent": false
    },
    {
      "source": "/join/:path(.*)",
      "destination": "https://join.synergysalon.com/:path",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
