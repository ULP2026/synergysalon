{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.synergysalon.com"
        }
      ],
      "destination": "/home",
      "permanent": false
    },
    {
      "source": "/staff",
      "has": [
        {
          "type": "host",
          "value": "app.synergysalon.com"
        }
      ],
      "destination": "/home",
      "permanent": false
    },
    {
      "source": "/staff/:path((?!vendor/).*)",
      "has": [
        {
          "type": "host",
          "value": "app.synergysalon.com"
        }
      ],
      "destination": "/:path",
      "permanent": false
    },
    {
      "source": "/book",
      "destination": "/?book=1",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "synergysalon.com"
        }
      ]
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.synergysalon.com"
        }
      ],
      "destination": "https://synergysalon.com/:path",
      "permanent": true
    },
    {
      "source": "/staff",
      "has": [
        {
          "type": "host",
          "value": "synergysalon.com"
        }
      ],
      "destination": "https://app.synergysalon.com/",
      "permanent": false
    },
    {
      "source": "/staff/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "synergysalon.com"
        }
      ],
      "destination": "https://app.synergysalon.com/:path",
      "permanent": false
    },
    {
      "source": "/join",
      "destination": "https://join.synergysalon.com/",
      "permanent": false
    },
    {
      "source": "/join/:path(.*)",
      "destination": "https://join.synergysalon.com/:path",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.synergysalon.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/s/:slug*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/sync",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/followups",
      "schedule": "0 15 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/:page(home|dashboard|appointments|clients|contacts|leads|settings|account|team|calendars|invite)",
      "has": [
        {
          "type": "host",
          "value": "app.synergysalon.com"
        }
      ],
      "destination": "/staff"
    },
    {
      "source": "/calendars/:slug",
      "has": [
        {
          "type": "host",
          "value": "app.synergysalon.com"
        }
      ],
      "destination": "/staff"
    },
    {
      "source": "/marketing",
      "has": [
        {
          "type": "host",
          "value": "app.synergysalon.com"
        }
      ],
      "destination": "/staff"
    },
    {
      "source": "/marketing/:sub(automation|history|finance|promotions|sms|email)",
      "has": [
        {
          "type": "host",
          "value": "app.synergysalon.com"
        }
      ],
      "destination": "/staff"
    },
    {
      "source": "/s/:tenant/:calendar",
      "destination": "/shop"
    },
    {
      "source": "/book/:calendar",
      "destination": "/shop"
    },
    {
      "source": "/staff/calendars/:slug",
      "destination": "/staff"
    },
    {
      "source": "/s/:slug",
      "destination": "/shop"
    },
    {
      "source": "/calendar/:token.ics",
      "destination": "/api/calendar?k=:token"
    },
    {
      "source": "/staff/:page(home|dashboard|appointments|clients|contacts|leads|settings|account|team|calendars|invite)",
      "destination": "/staff"
    },
    {
      "source": "/staff/marketing",
      "destination": "/staff"
    },
    {
      "source": "/staff/marketing/:sub(automation|history|finance|promotions|sms|email)",
      "destination": "/staff"
    }
  ]
}
