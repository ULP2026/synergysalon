{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.synergysalon.com"
        }
      ],
      "destination": "https://synergysalon.com/:path",
      "permanent": true
    },
    {
      "source": "/staff",
      "has": [
        {
          "type": "host",
          "value": "synergysalon.com"
        }
      ],
      "destination": "https://app.synergysalon.com/",
      "permanent": false
    },
    {
      "source": "/join",
      "destination": "https://join.synergysalon.com/",
      "permanent": false
    },
    {
      "source": "/join/:path(.*)",
      "destination": "https://join.synergysalon.com/:path",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/sync",
      "schedule": "30 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "app.synergysalon.com"
        }
      ],
      "destination": "/staff/index.html"
    }
  ]
}
